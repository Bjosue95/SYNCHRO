                : "Disponible"
            }}
          </span>

          <span
            v-if="seleccionado === item.codigo"
            class="marca"
            aria-hidden="true"
          >
            ✓
          </span>
        </button>
      </div>
    </section>

    <footer class="pie">
      <p aria-live="polite">
        {{
          seleccionado
            ? `Casillero ${seleccionado} elegido. Aún no está reservado.`
            : "Toca un casillero disponible para seleccionarlo."
        }}
      </p>

      <button
        type="button"
        class="boton-ir-rostro"
        :disabled="!seleccionado || cargando || !!error"
        @click="continuar"
      >
        <span>Continuar</span>

        <span class="icono-ir" aria-hidden="true">
          <img
            src="/iconos/complementarios/29_continuar.svg"
            class="claro"
            alt=""
          />
          <img
            src="/iconos/complementarios/29_continuar-oscuro.svg"
            class="oscuro"
            alt=""
          />
        </span>
      </button>
      <nav
        v-if="totalPaginas > 1 && !error && !cargando"
        class="paginas"
        aria-label="Páginas de casilleros"
      >
        <button
          type="button"
          :disabled="pagina === 0"
          @click="cambiarPagina(pagina - 1)"
        >
          Anterior
        </button>

        <span>{{ pagina + 1 }} / {{ totalPaginas }}</span>

        <button
          type="button"
          :disabled="pagina + 1 >= totalPaginas"
          @click="cambiarPagina(pagina + 1)"
        >
          Siguiente
        </button>
      </nav>
    </footer>
